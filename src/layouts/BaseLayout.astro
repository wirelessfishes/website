---
import "@styles/style.css"
import TabBar from "@components/TabBar.astro";
import TabElement from "@components/TabElement.astro";
import { colors } from "@scripts/colors";
import SiteStats from "@components/SiteStats.svelte";
import StatusCafe from "@components/StatusCafe.svelte";
import FloatingImg from "@components/FloatingImg.svelte";
import RecentScrobble from "@components/RecentScrobble.svelte";

const {title, description, og_img} = Astro.props;

const color_vars = `:root {\n${Object.entries(colors)
  .map(([k, v]) => `  --${k}: ${v};`)
  .join('\n')}\n}`;
---
<style set:html={color_vars} is:global></style>

<style>
  html {
    display: flex;
    justify-content: center;
    align-items: start;
    overflow: scroll;
  }

  body {
    display: grid;
    grid-template-columns: 200px 1000px 200px;
  }

  footer {
    margin-bottom: 16px;
  }

  .header-title {
    height: 170px;
    background-image: url("/header.jpg");

    display: flex;
    justify-content: start;
    align-items: end;

    h1, a {
      margin: 0;
      padding: 0;

      text-decoration: none !important;
    }

    h1 {
      padding: 4px 16px;
      max-width: 600px;
      overflow: hidden;
      height: fit-content;
      text-align: left;
      background: linear-gradient(to right, var(--black) 81%, transparent);

      border-image: linear-gradient(to left, var(--red));
    }
  }

  .sidebar {
    height: 100%;
  }

  .content {
  background-color: var(--black);
  min-height: 100vh;
  max-width: 1000px;
}

  .sidelink {
    margin-top: 256px;
    margin-left: 16px
  }

  .sidecard {
    background-color: var(--black);
    padding: 4px 8px;

    border: 1px solid var(--grey);
    border-right: none;
  }

  @media (max-width: 1000px) {
    .sidebar {display: none;}
    body {display: block;}
  }

  @media (max-width: 550px) {
    .header-title > h1 {font-size: 26px; background: var(--black); width: 100%; text-align: center;}
    .header-title {height: 120px; background-size: contain;}
  }
</style>

<!DOCTYPE html>

<html lang="en-US">
  <head>
    <!-- META -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={`https://wireless.fish${Astro.url}`}  />

    <link href="https://bsky.app/profile/wireless.fish" rel="me">

    <!-- SOME STUFF -->
    <title>{ title }</title>
    <meta name="description" content={ description } />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="alternate icon" type="image/png" href="/assets/favicon.png">

    <!-- https://ogp.me stuff -->
    <meta property="og:url" content={`https://wireless.fish${Astro.url}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ title } />
    <meta property="og:locale" content="en_US" />
    
    {description ? (
      <meta property="og:description" content={ description } />
    ) : ""}

    { og_img ? (
      <meta property="og:image" content={ og_img } />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    ) : "" }

    <!-- twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ title } />
    
    { description ? (
      <meta name="twitter:description" content={ description } />
    ) : ""}

    { og_img ? (
      <meta name="twitter:image" content={ og_img } />
    ) : ""}
  </head>

  <body>
    <div class="sidebar">
      <div class="sidecard" style="margin-top: 195px;">
        <SiteStats client:only/>
      </div>

      <div class="sidecard" style="margin-top: 8px;">
        <StatusCafe client:only/>
      </div>

      <FloatingImg alt="a blacktip shark" src="/assets/sharks/blacktip.webp" top="-10px" left="-20px" width="256px"/>

      <div class="sidecard" style="margin-top: 45px; padding: 8px;">
        <RecentScrobble client:only/>
      </div>
    </div>

    <div class="content">
      <header>
          <div class="header-title">
            <h1><a href="/">wireless.fish</a></h1>
          </div>
        
          <TabBar>
            <TabElement href="/">Home</TabElement>
            <TabElement href="/collections/">Collections</TabElement>
            <TabElement href="/scrobbles/">Scrobbles</TabElement>
            <TabElement href="/guestbook/">Guestbook</TabElement>
          </TabBar>

          <FloatingImg alt="a great white shark" src="/assets/sharks/great_white.webp" top="-130px" left="930px" width="256px"/>
      </header>

      <slot />

      <footer style="text-align: center; display: flex; flex-direction: column; gap: 1px; margin-top: 0.5em;">
        <div>
          ♡ Copying is an act of theft, while taking inspiration is the true act of love.
          <a class="link-button link-alt" href="https://maxpixels.moe/manifesto/">🡕</a>
        </div>

        <div>© Sharky 2025-2026 <a class="link-button link-alt" href="/LICENSE.txt">→</a></div>
      </footer>
    </div>

    <div class="sidebar">
        <iframe class="sidelink" width="150" height="450" style="border:none" src="https://dogspit.nekoweb.org/sidelink.html" name="sidelink"></iframe>
        <FloatingImg alt="a blacktip shark" src="/assets/sharks/blacktip2.webp" top="10px" left="-20px" width="256px"/>
    </div>
  </body>
</html>