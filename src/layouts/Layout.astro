---
import "../assets/css/reset.css";
import "../assets/css/style.css";
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";

const { title } = Astro.props;
---

<style>
  body {
    background-color: #0d1e4e;
    background-image: url("/assets/images/ocean_underwater.jpg");
    background-size: cover;
    color: white;
    min-height: 100vh;
    font-family: sans-serif;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .content {
    max-width: 1200px;
    min-height: 100vh;
    background-color: #0f172a;
    box-shadow: 0px 0px 16px black;
  }

  footer {
    text-align: center;
    font-style: italic;
  }

  header {
    width: 100%;
    padding: 8px;

    h1 {
      font-size: 50px;
    }

    a {
      text-decoration: none;
      padding: 4px 8px;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={title} />
  </head>

  <body>
    <div class="content">
      <img
        alt="low-poly blacktip shark model"
        style="float: right; width: 200px; margin: 8px;"
        src="/assets/shark.png"
      />

      <header>
        <h1 style="display: inline;">
          <a href="/">wireless.fish</a>
        </h1>

        <span style="font-style: italic; opacity: 50%;">Fishes do NOT contain wires</span>

        <Navbar />
      </header>

      <slot />

      <footer>
        <div>
          ♡ Copying is an act of theft, while taking inspiration is the true act of love.
          <a href="https://maxpixels.moe/manifesto/">⧉</a>
        </div>

        <div>Made with SPITE, BOREDOM and my FUCKED UP BRAIN. © Sharky 2025-2026 <a href="/license/">↗</a></div>
      </footer>
    </div>
  </body>
</html>
