---
import Layout from "../layouts/Layout.astro";
import Buttons88x31 from "../components/Buttons88x31.astro";
---

<style>
  .content-pad {
    padding: 8px;
  }

  .grid-1-1 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .msg-bottle {
    position: relative;

    img {
      width: 200px;
    }

    form {
      position: absolute;
      top: 180px;
      left: 5px;
      width: 200px;
      padding: 8px;

      background-color: rgba(32, 32, 32, 0.5);
    }

    form textarea {
      height: 128px;
      width: 100%;
      resize: vertical;
    }

    form button {
      width: 100%;
    }

    form input {
      width: 180px;
    }
  }
</style>

<script src="/scripts/statuscafe.js" defer type="module"></script>

<Layout title="Sharky's website">
  <section class="content-pad">
    <h2>SOFTWARE, HARDWARE, SHARKS AND MORE</h2>
    <p>
      Have you ever thought <i>"wow I need to see that website of some person posing as a shark online"</i>? WELL YOU'VE
      COME TO THE RIGHT PLACE!
    </p>
  </section>

  <section class="content-pad">
    <h2>Contact:</h2>
    <p>WARNING: I may bite</p>
    <ul>
      <li>Discord: wirelessfishes (1248946136123707495)</li>
      <li>E-Mail: sharky@wireless.fish</li>
    </ul>
  </section>

  <section class="content-pad">
    <h2>Cool websites:</h2>
    <Buttons88x31 />
  </section>

  <section class="content-pad" style="position: relative; color: black;">
    <img alt="shark say" src="/assets/sharksay.jpg" />

    <div style="position: absolute; top: 70px; left: 70px;">
      <span id="statuscafe-username" style="margin-right: 4px;">username</span>
      <span id="statuscafe-ago">date</span>
    </div>

    <div
      id="statuscafe-content"
      style="position: absolute; top: 95px; left: 50px; width: 190px; background-color: white; text-align: center;"
    >
      blub blub blub (content not loaded yet)
      <noscript>(requires javascript)</noscript>
    </div>
  </section>

  <section class="msg-bottle">
    <img alt="glass bottle" src="/assets/images/bottle.png" style="image-rendering: pixelated; width: 200px" />

    <form>
      <label>Send me an anonymous message in a bottle!</label>
      <textarea placeholder="hello, sharky"></textarea>
      <button type="submit">Send</button>
    </form>
  </section>
</Layout>
