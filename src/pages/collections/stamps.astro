---
import Layout from "../../layouts/Collection.astro";

const imagePaths = Object.values(
  import.meta.glob("/public/assets/stamps/*.{png,jpg,jpeg,webp,gif}", {
    query: "?url",
    import: "default",
    eager: true,
  })
);

const filenames = Object.values(imagePaths)
  .map((urlPath) => {
    if (typeof urlPath !== "string") return "";
    const cleanPath = urlPath.split("?")[0];
    return cleanPath.split("/").pop() || "";
  })
  .filter(Boolean);
---

<style>
  .stamps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;

    img {
      width: 99px;
      height: 57px;
    }
  }
</style>

<Layout title="Stamps">
  <h1>Stamps</h1>

  <div class="stamps">
    {filenames.map((filename) => <img alt={filename} src={"/assets/stamps/" + filename} loading="lazy" />)}
  </div>

  <a href="/collections/">go back?</a>
</Layout>
