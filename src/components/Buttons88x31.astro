---
import json from "../data/website_buttons.json";
---

<style>
  div > a > img {
    width: 88px;
    height: 31px;
    image-rendering: pixelated;
  }

  div > a {
    border: 1px solid transparent;
    display: block;
    transition: 200ms;
  }

  div > a:hover {
    border: 1px solid white;
    background: transparent;
  }

  div {
    display: flex;
    flex-wrap: wrap;
  }

  .noelle:hover {
    filter: invert(100%);
  }
</style>

<div>
  {
    json.buttons.map((btn) => (
      <a href={btn.href} class={btn.class}>
        <img loading="lazy" alt={btn.alt} src={btn.src} />
      </a>
    ))
  }
</div>
