---
const { src, alt, href, css_classes = "" } = Astro.props;
---

<style>
  a,
  img {
    height: 31px;
    width: 88px;
    image-rendering: pixelated;
    background-color: transparent;
    padding: 0 0;
  }
</style>

<a target="_blank" href={href} class={css_classes}>
  <img loading="lazy" src={src} alt={alt} />
</a>
