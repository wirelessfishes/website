---
import { AeroButtonColors } from "../scripts/aerobutton";

const { color, id = "", type, text_color = "#fff" } = Astro.props;

const buttonc = AeroButtonColors(color);
---

<style
  define:vars={{
    color: buttonc.regular.base,
    color_lighter: buttonc.regular.lighter,
    color_border: buttonc.border,
    color_hover: buttonc.hover.base,
    color_hover_lighter: buttonc.hover.lighter,
    text_color: text_color,
  }}
>
  button {
    background: linear-gradient(to bottom, var(--color_lighter), var(--color_lighter), var(--color), var(--color));
    box-shadow: inset 0 0 0 1px var(--color_border);
    border-radius: 2px;
    border: 0px;
    cursor: pointer;
    font-family: "Stack Sans Text";
    outline: 0px solid transparent;

    color: var(--text_color);
    text-shadow: 0px 0px 4px var(--black);
    padding: 2px 1em;

    text-decoration: none;
    text-align: center;
  }

  button:hover {
    background: linear-gradient(
      to bottom,
      var(--color_hover_lighter),
      var(--color_hover_lighter),
      var(--color_hover),
      var(--color_hover)
    );
  }
</style>

<button id={id} type={type}>
  <slot />
</button>
