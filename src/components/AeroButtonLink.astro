---
import Color from "color";

const { color, text_color = "var(--white)", href, target = "_self" } = Astro.props;

const color_lighter = Color(color).lighten(0.3).hex();
const color_border = Color(color).lighten(0.5).fade(0.5).hexa();

const color_hover = Color(color).darken(0.15).hex();
const color_hover_lighter = Color(color_lighter).darken(0.15).hex();
---

<style define:vars={{ color, color_lighter, color_border, color_hover, color_hover_lighter }}>
  a {
    background: linear-gradient(to bottom, var(--color_lighter), var(--color_lighter), var(--color), var(--color));
    box-shadow: inset 0 0 0 1px var(--color_border);
    border-radius: 2px;

    color: var(--white);
    text-shadow: 0px 0px 4px var(--black);
    padding: 2px 8px;

    text-decoration: none;
    text-align: center;
  }

  a:hover {
    background: linear-gradient(
      to bottom,
      var(--color_hover_lighter),
      var(--color_hover_lighter),
      var(--color_hover),
      var(--color_hover)
    );
  }
</style>

<a href={href} target={target}>
  <slot />
</a>
