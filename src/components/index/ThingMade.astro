---
const { title, description, date, image } = Astro.props;
---

<style>
  .thingimade {
    display: flex;

    background: linear-gradient(to bottom, var(--darkgrey), var(--darkergrey));

    border-top: 1px solid #474747;
    border-bottom: 1px solid #474747;
  }

  .img-wrapper {
    width: 300px;
    height: 100%;
    flex-shrink: 0;
  }

  h3 > span {
    font-weight: normal;
  }

  .thingimade_content {
    padding: 8px 16px;
  }

  @media (max-width: 800px) {
    .thingimade {
      flex-direction: column;
    }

    .img-wrapper {
      padding: 8px;
      display: flex;
      justify-content: center;
      width: 100%;
      height: 250px;
    }
  }
</style>

<div class="thingimade">
  <div class="img-wrapper">
    <img loading="lazy" src={image} />
  </div>

  <div class="thingimade_content">
    <h3>{title} <span>({date})</span></h3>
    <slot />
  </div>
</div>
