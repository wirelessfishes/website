<!DOCTYPE html>

<html lang="en-US">
  <head>
    <!-- META -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="{{eleventy.generator}}" />
    <link rel="canonical" href="https://wireless.fish{{ page.url }}" />

    <link href="https://bsky.app/profile/wireless.fish" rel="me">

    <!-- SOME STUFF -->
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="alternate icon" type="image/png" href="/assets/favicon.png">

    <!-- https://ogp.me stuff -->
    <meta property="og:url" content="https://wireless.fish{{ page.url }}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:locale" content="en_US" />
    
    {% if description %}
      <meta property="og:description" content="{{ description }}" />
    {% endif %}

    {% if og_img %}
      <meta property="og:image" content="{{ og_img }}" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    {% endif %}

    <!-- twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }}" />
    {% if description %}<meta name="twitter:description" content="{{ description }}" />{% endif %}
    {% if og_img %}<meta name="twitter:image" content="{{ og_img }}" />{% endif %}

    {# base styles #}
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" href="/assets/favicon.png">

    {% block head %}
    {% endblock %}

    {% block style %}
    {% endblock %}

    {% for sheet in extra_css %}
      <link rel="stylesheet" href="{{ sheet }}" />
    {% endfor %}
  </head>

  <body>    
    <div class="content">
      <header>
        <h1 class="site-title"><a href="/">wireless.fish</a></h1>
        
        <nav>
          <a href="/" class="link-alt">Home</a>
          <a href="/collections" class="link-alt">Collections</a>
          <a href="/scrobbles" class="link-alt">Scrobbles</a>
          <a href="/guestbook" class="link-alt">Guestbook</a>
          <span class="nav-spacer"></span>
          <a href="https://github.com/wirelessfishes" class="link-alt">Git 🡕</a>
        </nav>
      </header>

      {{ content | safe }}

      <footer style="text-align: center; display: flex; flex-direction: column; gap: 1px; margin-top: 0.5em;">
        <div>
          ♡ Copying is an act of theft, while taking inspiration is the true act of love.
          <a class="link-button link-alt" href="https://maxpixels.moe/manifesto/">🡕</a>
        </div>

        <div>© Sharky 2025-2026 <a class="link-button link-alt" href="/LICENSE.txt">→</a></div>
      </footer>
    </div>
  </body>
</html>