{
  "name": "website",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"public/css/**/*.css\"",
    "lint:css:fix": "stylelint \"public/css/**/*.css\" --fix",
    "build:scripts": "esbuild \"src/scripts/*.ts\" --bundle --outdir=dist/scripts --format=esm",
    "build": "pnpm run build:scripts && pnpm exec eleventy",
    "dev:scripts": "esbuild \"src/scripts/*.ts\" --bundle --outdir=dist/scripts --format=esm --watch",
    "dev": "pnpm run build:scripts && concurrently \"pnpm run dev:scripts\" \"pnpm exec eleventy --serve\""
  },
  "type": "module",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  }
}
